<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>4.1.1</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <Description>The CLI's studio theme checks, shipped with the Studio so the headless CLI carries no GUI toolkit.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Cli.Sdk/Turian.Cli.Sdk.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Host/Gaya.Host.csproj"/>
    </ItemGroup>
</Project>
